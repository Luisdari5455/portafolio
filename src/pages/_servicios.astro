---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Code, Smartphone, Cloud, Brain, Shield, BarChart3, Check } from '@lucide/astro';

const services = [
  {
    id: 'web',
    icon: 'Code',
    title: 'Desarrollo Web',
    description: 'Creamos aplicaciones web modernas, responsivas y de alto rendimiento.',
    features: [
      'Aplicaciones web progresivas (PWA)',
      'E-commerce y plataformas de venta',
      'Sistemas de gestión empresarial',
      'Portales corporativos',
    ],
    technologies: ['React', 'Vue', 'Angular', 'Astro', 'Next.js', 'Node.js']
  },
  {
    id: 'mobile',
    icon: 'Smartphone',
    title: 'Desarrollo Móvil',
    description: 'Apps nativas y multiplataforma que ofrecen experiencias excepcionales.',
    features: [
      'Aplicaciones iOS y Android',
      'Apps multiplataforma con React Native',
      'Diseño UI/UX optimizado para móvil',
      'Integración con APIs y servicios',
    ],
    technologies: ['React Native', 'Flutter', 'Swift', 'Kotlin', 'Ionic']
  },
  {
    id: 'cloud',
    icon: 'Cloud',
    title: 'Soluciones Cloud',
    description: 'Infraestructura escalable y segura en la nube para tu negocio.',
    features: [
      'Migración a la nube',
      'Arquitectura serverless',
      'DevOps y CI/CD',
      'Optimización de costos cloud',
    ],
    technologies: ['AWS', 'Azure', 'Google Cloud', 'Docker', 'Kubernetes']
  },
  {
    id: 'ai',
    icon: 'Brain',
    title: 'IA & Machine Learning',
    description: 'Implementamos inteligencia artificial para automatizar y optimizar.',
    features: [
      'Modelos de Machine Learning',
      'Procesamiento de lenguaje natural',
      'Análisis predictivo',
      'Automatización inteligente',
    ],
    technologies: ['TensorFlow', 'PyTorch', 'OpenAI', 'Scikit-learn', 'Python']
  },
  {
    id: 'security',
    icon: 'Shield',
    title: 'Ciberseguridad',
    description: 'Protegemos tu infraestructura digital contra amenazas y vulnerabilidades.',
    features: [
      'Auditorías de seguridad',
      'Penetration testing',
      'Protección DDoS',
      'Compliance y normativas',
    ],
    technologies: ['OWASP', 'ISO 27001', 'SSL/TLS', 'WAF', 'SIEM']
  },
  {
    id: 'consulting',
    icon: 'BarChart3',
    title: 'Consultoría IT',
    description: 'Asesoramiento experto para optimizar tu estrategia tecnológica.',
    features: [
      'Análisis de infraestructura',
      'Estrategia de transformación digital',
      'Optimización de procesos',
      'Capacitación y training',
    ],
    technologies: ['Agile', 'Scrum', 'ITIL', 'TOGAF', 'DevOps']
  },
];

const iconMap = {
  Code,
  Smartphone,
  Cloud,
  Brain,
  Shield,
  BarChart3
};
---

<MainLayout 
  title="Servicios"
  description="Descubre nuestras soluciones tecnológicas integrales para impulsar tu negocio"
>
  <Header />
  
  <main>
    <!-- Page Header -->
    <section class="page-header">
      <div class="container">
        <h1 class="page-title">Nuestros Servicios</h1>
        <p class="page-description">
          Soluciones tecnológicas a medida para cada necesidad de tu negocio
        </p>
      </div>
    </section>

    <!-- Services Detail -->
    <section class="section services-section">
      <div class="container">
        {services.map((service, index) => {
          const IconComponent = iconMap[service.icon];
          return (
            <div id={service.id} class={`service-detail ${index % 2 === 1 ? 'reverse' : ''}`}>
              <div class="service-content">
                <div class="service-header">
                  <div class="service-icon-large">
                    <IconComponent size={56} strokeWidth={1.5} />
                  </div>
                  <h2>{service.title}</h2>
                </div>
                <p class="service-description">{service.description}</p>
                
                <h3>Características</h3>
                <ul class="features-list">
                  {service.features.map((feature) => (
                    <li><Check size={16} stroke-width={2.5} /> {feature}</li>
                  ))}
                </ul>
                
                <div class="technologies">
                  <h4>Tecnologías</h4>
                  <div class="tech-tags">
                    {service.technologies.map((tech) => (
                      <span class="tech-tag">{tech}</span>
                    ))}
                  </div>
                </div>
                
                <a href="/contacto" class="btn btn-primary">Solicitar Cotización</a>
              </div>
              
              <div class="service-visual">
                <div class="visual-placeholder">
                  <div class="visual-icon">
                    <IconComponent size={120} strokeWidth={1} />
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- CTA -->
    <section class="section cta-section">
      <div class="container">
        <div class="cta-content">
          <h2>¿No encuentras lo que buscas?</h2>
          <p>Contáctanos y diseñaremos una solución personalizada para ti</p>
          <a href="/contacto" class="btn btn-secondary btn-lg">Hablar con un Experto</a>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</MainLayout>

<style>
  main {
    margin-top: 70px;
  }

  .page-header {
    background: linear-gradient(135deg, var(--color-bg-dark), var(--color-bg-dark-alt));
    color: white;
    padding: var(--spacing-xl) 0;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .page-header::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(
      circle,
      rgba(255, 189, 89, 0.1) 0%,
      transparent 70%
    );
    animation: float 20s infinite;
  }
  
  .page-title {
    color: white;
    font-size: 3rem;
    margin-bottom: var(--spacing-sm);
    text-shadow: 0 0 20px rgba(255, 189, 89, 0.5);
    position: relative;
    z-index: 1;
  }
  
  .page-description {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.9);
    max-width: 700px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  
  .services-section {
    background: linear-gradient(180deg, #ffffff 0%, #f8f9fa 100%);
  }
  
  .service-detail {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
    align-items: center;
    margin-bottom: var(--spacing-xl);
    padding: var(--spacing-lg);
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(10px);
    border-radius: var(--border-radius-xl);
    border: 1px solid rgba(255, 189, 89, 0.1);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
  }

  .service-detail:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 60px rgba(255, 189, 89, 0.15);
    border: 1px solid rgba(255, 189, 89, 0.3);
  }
  
  .service-detail.reverse {
    direction: rtl;
  }
  
  .service-detail.reverse > * {
    direction: ltr;
  }
  
  .service-header {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-sm);
  }
  
  .service-icon-large {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 70px;
    height: 70px;
    background: linear-gradient(135deg, rgba(255, 189, 89, 0.15), rgba(255, 107, 53, 0.15));
    border-radius: var(--border-radius-lg);
    border: 2px solid rgba(255, 189, 89, 0.3);
    color: var(--color-primary);
    animation: pulse 3s infinite;
    transition: all 0.3s ease;
  }

  .service-detail:hover .service-icon-large {
    background: linear-gradient(135deg, rgba(255, 189, 89, 0.25), rgba(255, 107, 53, 0.25));
    border-color: var(--color-primary);
    transform: scale(1.1);
  }
  
  .service-detail h2 {
    font-size: 2rem;
    margin: 0;
  }
  
  .service-description {
    font-size: 1.125rem;
    color: var(--color-text-light);
    margin-bottom: var(--spacing-md);
  }
  
  .service-detail h3 {
    font-size: 1.5rem;
    margin-bottom: var(--spacing-sm);
  }
  
  .features-list {
    list-style: none;
    padding: 0;
    margin-bottom: var(--spacing-md);
  }
  
  .features-list li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0;
    font-size: 1.125rem;
    color: var(--color-text);
  }
  
  .features-list li :global(svg) {
    flex-shrink: 0;
    color: var(--color-primary-dark);
  }

  .technologies {
    margin-bottom: var(--spacing-md);
  }
  
  .technologies h4 {
    font-size: 1.125rem;
    margin-bottom: var(--spacing-sm);
  }
  
  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  
  .tech-tag {
    background: linear-gradient(135deg, rgba(255, 189, 89, 0.1), rgba(255, 189, 89, 0.2));
    color: var(--color-primary-dark);
    padding: 0.5rem 1rem;
    border-radius: var(--border-radius-md);
    font-size: 0.875rem;
    font-weight: 600;
    border: 1px solid rgba(255, 189, 89, 0.3);
    transition: all 0.3s ease;
  }

  .tech-tag:hover {
    background: var(--color-primary);
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(255, 189, 89, 0.3);
  }
  
  .service-visual {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .visual-placeholder {
    width: 100%;
    max-width: 400px;
    aspect-ratio: 1;
    background: linear-gradient(135deg, rgba(255, 189, 89, 0.1), rgba(255, 107, 53, 0.1));
    border-radius: var(--border-radius-xl);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-lg);
    position: relative;
    overflow: hidden;
  }

  .visual-placeholder::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(
      circle,
      rgba(255, 189, 89, 0.2) 0%,
      transparent 70%
    );
    animation: float 15s infinite;
  }
  
  .visual-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--color-primary);
    opacity: 0.4;
    position: relative;
    z-index: 1;
    filter: drop-shadow(0 0 30px rgba(255, 189, 89, 0.3));
  }
  
  .cta-section {
    background: linear-gradient(135deg, var(--color-bg-dark), var(--color-bg-dark-alt));
    position: relative;
    overflow: hidden;
  }

  .cta-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      45deg,
      transparent 0%,
      rgba(255, 189, 89, 0.1) 50%,
      transparent 100%
    );
    animation: gradientShift 10s infinite;
  }
  
  .cta-content {
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  
  .cta-content h2 {
    font-size: 2.5rem;
    margin-bottom: var(--spacing-sm);
    color: white;
    text-shadow: 0 0 20px rgba(255, 189, 89, 0.5);
  }
  
  .cta-content p {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: var(--spacing-md);
  }
  
  .btn-lg {
    padding: 1.125rem 2.5rem;
    font-size: 1.125rem;
  }
  
  @media (max-width: 968px) {
    .service-detail {
      grid-template-columns: 1fr;
    }
    
    .service-detail.reverse {
      direction: ltr;
    }
    
    .visual-placeholder {
      max-width: 300px;
    }
    
    .visual-icon {
      font-size: 6rem;
    }
  }
  
  @media (max-width: 768px) {
    .page-title {
      font-size: 2rem;
    }
    
    .service-detail h2 {
      font-size: 1.5rem;
    }
  }
</style>
