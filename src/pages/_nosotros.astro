---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Globe, Handshake, Star, Target, UserRound } from '@lucide/astro';

const values = [
  {
    icon: Target,
    title: 'Innovación',
    description: 'Buscamos constantemente nuevas formas de resolver problemas y crear valor.'
  },
  {
    icon: Handshake,
    title: 'Compromiso',
    description: 'Nos dedicamos al éxito de nuestros clientes como si fuera el nuestro.'
  },
  {
    icon: Star,
    title: 'Excelencia',
    description: 'Calidad superior en cada línea de código y en cada interacción.'
  },
  {
    icon: Globe,
    title: 'Visión Global',
    description: 'Pensamos globalmente mientras actuamos localmente.'
  },
];

const team = [
  {
    name: 'Ana García',
    role: 'CEO & Fundadora',
    bio: '15+ años de experiencia en tecnología empresarial'
  },
  {
    name: 'Carlos Méndez',
    role: 'CTO',
    bio: 'Experto en arquitectura de software y cloud'
  },
  {
    name: 'María López',
    role: 'Director de Diseño',
    bio: 'Especialista en UX/UI y diseño de experiencias'
  },
  {
    name: 'Juan Rodríguez',
    role: 'Director de IA',
    bio: 'PhD en Machine Learning y Data Science'
  },
];
---

<MainLayout 
  title="Nosotros"
  description="Conoce al equipo detrás de INNOVATECH GLOBAL SOLUTIONS"
>
  <Header />
  
  <main>
    <!-- Page Header -->
    <section class="page-header">
      <div class="container">
        <h1 class="page-title">Sobre Nosotros</h1>
        <p class="page-description">
          Transformando el futuro digital, un proyecto a la vez
        </p>
      </div>
    </section>

    <!-- Mission Section -->
    <section class="section mission-section">
      <div class="container">
        <div class="mission-content">
          <div class="mission-text">
            <h2>Nuestra Misión</h2>
            <p>
              En INNOVATECH GLOBAL SOLUTIONS, creamos soluciones tecnológicas innovadoras 
              que impulsan el crecimiento y la transformación digital de empresas en todo el mundo.
            </p>
            <p>
              Combinamos experiencia técnica de clase mundial con un profundo entendimiento 
              de las necesidades del negocio para entregar resultados excepcionales.
            </p>
          </div>
          
          <div class="mission-visual">
            <div class="stats-grid">
              <div class="stat-box">
                <div class="stat-number">500+</div>
                <div class="stat-label">Proyectos</div>
              </div>
              <div class="stat-box">
                <div class="stat-number">200+</div>
                <div class="stat-label">Clientes</div>
              </div>
              <div class="stat-box">
                <div class="stat-number">50+</div>
                <div class="stat-label">Países</div>
              </div>
              <div class="stat-box">
                <div class="stat-number">15+</div>
                <div class="stat-label">Años</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Values Section -->
    <section class="section values-section">
      <div class="container">
        <h2 class="section-title text-center">Nuestros Valores</h2>
        <p class="section-description text-center">
          Los principios que guían cada decisión que tomamos
        </p>
        
        <div class="grid grid-4">
          {values.map((value) => (
            <div class="value-card card">
              <div class="value-icon"><value.icon size={48} stroke-width={1.5} /></div>
              <h3>{value.title}</h3>
              <p>{value.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Timeline Section -->
    <section class="section timeline-section">
      <div class="container">
        <h2 class="section-title text-center">Nuestra Historia</h2>
        
        <div class="timeline">
          <div class="timeline-item">
            <div class="timeline-year">2010</div>
            <div class="timeline-content">
              <h3>Fundación</h3>
              <p>INNOVATECH nace con la visión de democratizar la tecnología empresarial.</p>
            </div>
          </div>
          
          <div class="timeline-item">
            <div class="timeline-year">2015</div>
            <div class="timeline-content">
              <h3>Expansión Global</h3>
              <p>Abrimos oficinas en 10 países y alcanzamos 100 clientes internacionales.</p>
            </div>
          </div>
          
          <div class="timeline-item">
            <div class="timeline-year">2020</div>
            <div class="timeline-content">
              <h3>Transformación Digital</h3>
              <p>Lideramos la transformación digital durante la pandemia global.</p>
            </div>
          </div>
          
          <div class="timeline-item">
            <div class="timeline-year">2026</div>
            <div class="timeline-content">
              <h3>Innovación con IA</h3>
              <p>Lanzamiento de nuestra división de Inteligencia Artificial y Machine Learning.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Team Section -->
    <section class="section team-section">
      <div class="container">
        <h2 class="section-title text-center">Nuestro Equipo</h2>
        <p class="section-description text-center">
          Conoce a los expertos que hacen posible la magia
        </p>
        
        <div class="grid grid-4">
          {team.map((member) => (
            <div class="team-card card">
              <div class="member-avatar"><UserRound size={48} stroke-width={1.5} /></div>
              <h3>{member.name}</h3>
              <p class="member-role">{member.role}</p>
              <p class="member-bio">{member.bio}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section cta-section">
      <div class="container">
        <div class="cta-content">
          <h2>¿Quieres formar parte de nuestro equipo?</h2>
          <p>Estamos siempre buscando talento excepcional</p>
          <a href="/contacto" class="btn btn-primary btn-lg">Trabaja con Nosotros</a>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</MainLayout>

<style>
  main {
    margin-top: 70px;
  }

  .page-header {
    background: linear-gradient(135deg, var(--color-bg-dark), var(--color-bg-dark-alt));
    color: white;
    padding: var(--spacing-xl) 0;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .page-header::before {
    content: '';
    position: absolute;
    top: -100%;
    left: -100%;
    width: 300%;
    height: 300%;
    background: radial-gradient(
      circle,
      rgba(255, 189, 89, 0.15) 0%,
      transparent 60%
    );
    animation: float 30s infinite;
  }
  
  .page-title {
    color: white;
    font-size: 3rem;
    margin-bottom: var(--spacing-sm);
    text-shadow: 0 0 30px rgba(255, 189, 89, 0.6);
    position: relative;
    z-index: 1;
  }
  
  .page-description {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.95);
    max-width: 700px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  
  .mission-section {
    background: linear-gradient(180deg, #ffffff 0%, #f8f9fa 100%);
  }
  
  .mission-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
    align-items: center;
  }
  
  .mission-text h2 {
    font-size: 2.5rem;
    margin-bottom: var(--spacing-md);
  }
  
  .mission-text p {
    font-size: 1.125rem;
    color: var(--color-text-light);
    margin-bottom: var(--spacing-sm);
    line-height: 1.8;
  }
  
  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-md);
  }
  
  .stat-box {
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(10px);
    padding: var(--spacing-md);
    border-radius: var(--border-radius-lg);
    text-align: center;
    border: 1px solid rgba(255, 189, 89, 0.2);
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
  }

  .stat-box:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(255, 189, 89, 0.2);
    border-color: var(--color-primary);
  }
  
  .stat-number {
    font-size: 2.5rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.5rem;
    text-shadow: 0 0 30px rgba(255, 189, 89, 0.3);
  }
  
  .stat-label {
    font-size: 1rem;
    color: var(--color-text-light);
    font-weight: 600;
  }
  
  .values-section {
    background: linear-gradient(180deg, #f8f9fa 0%, #ffffff 100%);
  }
  
  .section-title {
    font-size: 2.5rem;
    margin-bottom: var(--spacing-sm);
  }
  
  .section-description {
    font-size: 1.25rem;
    color: var(--color-text-light);
    margin-bottom: var(--spacing-lg);
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }
  
  .value-card {
    text-align: center;
    padding: var(--spacing-md);
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 189, 89, 0.15);
    transition: all 0.3s ease;
  }

  .value-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 40px rgba(255, 189, 89, 0.2);
    border-color: rgba(255, 189, 89, 0.4);
  }
  
  .value-icon {
    color: var(--color-primary-dark);
    line-height: 0;
    margin-bottom: var(--spacing-sm);
    filter: drop-shadow(0 0 15px rgba(255, 189, 89, 0.4));
    animation: pulse-slow 4s infinite;
  }
  
  .value-card h3 {
    font-size: 1.5rem;
    margin-bottom: var(--spacing-sm);
  }
  
  .value-card p {
    color: var(--color-text-light);
  }
  
  .timeline-section {
    background: linear-gradient(180deg, #ffffff 0%, #f8f9fa 50%, #ffffff 100%);
  }
  
  .timeline {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    padding: var(--spacing-md) 0;
  }
  
  .timeline::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(180deg, var(--color-primary), var(--color-secondary), var(--color-primary));
    transform: translateX(-50%);
    box-shadow: 0 0 20px rgba(255, 189, 89, 0.5);
  }
  
  .timeline-item {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-lg);
    position: relative;
  }
  
  .timeline-item:nth-child(even) {
    direction: rtl;
  }
  
  .timeline-item:nth-child(even) > * {
    direction: ltr;
  }
  
  .timeline-year {
    text-align: right;
    font-size: 2rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    padding-right: var(--spacing-md);
    text-shadow: 0 0 20px rgba(255, 189, 89, 0.3);
  }
  
  .timeline-item:nth-child(even) .timeline-year {
    text-align: left;
    padding-left: var(--spacing-md);
    padding-right: 0;
  }
  
  .timeline-content {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    padding: var(--spacing-md);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-md);
    border: 1px solid rgba(255, 189, 89, 0.2);
    transition: all 0.3s ease;
  }

  .timeline-content:hover {
    transform: scale(1.03);
    box-shadow: 0 15px 40px rgba(255, 189, 89, 0.25);
    border-color: var(--color-primary);
  }
  
  .timeline-content h3 {
    font-size: 1.5rem;
    margin-bottom: var(--spacing-xs);
  }
  
  .timeline-content p {
    color: var(--color-text-light);
  }
  
  .team-section {
    background: linear-gradient(180deg, #f8f9fa 0%, #ffffff 100%);
  }
  
  .team-card {
    text-align: center;
    padding: var(--spacing-md);
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 189, 89, 0.15);
    transition: all 0.3s ease;
  }

  .team-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 50px rgba(255, 189, 89, 0.2);
    border-color: rgba(255, 189, 89, 0.5);
  }
  
  .member-avatar {
    width: 120px;
    height: 120px;
    margin: 0 auto var(--spacing-sm);
    background: linear-gradient(135deg, rgba(255, 189, 89, 0.2), rgba(255, 107, 53, 0.2));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary-dark);
    box-shadow: 0 10px 30px rgba(255, 189, 89, 0.3);
    transition: all 0.3s ease;
    border: 3px solid rgba(255, 189, 89, 0.3);
  }

  .team-card:hover .member-avatar {
    transform: scale(1.1) rotate(5deg);
    box-shadow: 0 15px 40px rgba(255, 189, 89, 0.5);
  }
  
  .team-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }
  
  .member-role {
    color: var(--color-primary);
    font-weight: 600;
    margin-bottom: var(--spacing-sm);
  }
  
  .member-bio {
    color: var(--color-text-light);
    font-size: 0.95rem;
  }
  
  .cta-section {
    background: linear-gradient(135deg, var(--color-bg-dark), var(--color-bg-dark-alt));
    position: relative;
    overflow: hidden;
  }

  .cta-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(
      circle at 30% 50%,
      rgba(255, 189, 89, 0.15) 0%,
      transparent 60%
    );
  }
  
  .cta-content {
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  
  .cta-content h2 {
    font-size: 2.5rem;
    margin-bottom: var(--spacing-sm);
    color: white;
    text-shadow: 0 0 30px rgba(255, 189, 89, 0.6);
  }
  
  .cta-content p {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: var(--spacing-md);
  }
  
  .btn-lg {
    padding: 1.125rem 2.5rem;
    font-size: 1.125rem;
  }
  
  @media (max-width: 968px) {
    .mission-content {
      grid-template-columns: 1fr;
    }
    
    .timeline::before {
      left: 20px;
    }
    
    .timeline-item {
      grid-template-columns: 1fr;
      padding-left: 60px;
    }
    
    .timeline-item:nth-child(even) {
      direction: ltr;
    }
    
    .timeline-year {
      text-align: left;
      padding-right: 0;
      padding-left: 0;
    }
    
    .timeline-item:nth-child(even) .timeline-year {
      text-align: left;
      padding-left: 0;
    }
  }
  
  @media (max-width: 768px) {
    .page-title {
      font-size: 2rem;
    }
    
    .section-title {
      font-size: 2rem;
    }
    
    .mission-text h2 {
      font-size: 2rem;
    }
  }
</style>
