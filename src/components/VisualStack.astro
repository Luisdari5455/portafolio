---
import { Braces, Cloud, GitBranch, Workflow } from '@lucide/astro';
import { stack } from '../data/profile';
import PixelStation from './PixelStation.astro';
const symbols: Record<string, string> = { 'React.js': '⚛', 'React Native': '⚛', TypeScript: 'TS', Redux: 'Rx', 'Next.js': 'N', TailwindCSS: '≈', 'C# / .NET': 'C#', 'Node.js': 'JS', Express: 'ex', 'SQL Server': 'SQL', MySQL: 'SQL' };
const labels = ['INTERFACE LAB', 'SERVER ROOM', 'DATABASE CORE', 'CLOUD OPS', 'TOOLKIT'];
const code = ['render(<Experience />);', 'await api.handle(request);', 'await db.query();', 'await cloud.sync(data);', 'await tools.connect();'];
const results = ['Interfaz lista.', 'Respuesta recibida.', 'Datos sincronizados.', 'Datos sincronizados.', 'Respuesta recibida.'];
---
<div class="section-body retro-stack">
  <div class="stack-hud"><span><span aria-hidden="true">▦</span> SELECT YOUR STATION</span><p>Explora las herramientas detrás de cada proyecto.</p><span class="demo-label">Demo visual</span></div>
  <div class="visual-stack">
    {stack.map((group, index) => <section class="stack-panel" data-stack-station aria-labelledby={`stack-group-${index}`}>
      <div class="station-title"><span>0{index+1} / {labels[index]}</span><span aria-hidden="true">▪ ▪ ▪</span></div>
      <div class="stack-panel-art"><PixelStation index={index % 3} /></div>
      <div class="station-body"><h3 id={`stack-group-${index}`}>{group.group}</h3><ul>{group.items.map(item => <li><span class="tech-symbol" aria-hidden="true">{symbols[item] ? <span>{symbols[item]}</span> : item.includes('Azure') ? <Cloud size={17} stroke-width={1.3} /> : item.includes('GitHub') ? <GitBranch size={17} stroke-width={1.3} /> : item.includes('Kafka') ? <Workflow size={17} stroke-width={1.3} /> : <Braces size={17} stroke-width={1.3} />}</span><span>{item}</span></li>)}</ul>
        <div class="station-terminal"><code>{code[index]}</code><p aria-live="polite"><span data-station-idle>Esperando tu señal…</span><span data-station-result hidden>{results[index]}</span></p></div>
        <button type="button" data-station-toggle aria-pressed="false" hidden><span data-station-start>Probar estación</span><span data-station-reset hidden>Restablecer</span><span aria-hidden="true">↗</span></button>
      </div>
    </section>)}
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-stack-station]').forEach(station => {
    const button = station.querySelector<HTMLButtonElement>('[data-station-toggle]');
    if (!button) return;
    button.hidden = false;
    button.addEventListener('click', () => {
      const active = station.classList.toggle('is-active');
      button.setAttribute('aria-pressed', String(active));
      ['idle', 'start'].forEach(key => { const el = station.querySelector<HTMLElement>(`[data-station-${key}]`); if (el) el.hidden = active; });
      ['result', 'reset'].forEach(key => { const el = station.querySelector<HTMLElement>(`[data-station-${key}]`); if (el) el.hidden = !active; });
    });
  });
</script>
<style>
  .retro-stack { min-width: 0; }
  .stack-hud { display: flex; align-items: center; flex-wrap: wrap; gap: 12px 22px; padding-bottom: 20px; margin-bottom: 24px; border-bottom: 1px dashed var(--line); }
  .stack-hud > span:first-child { font: 10px monospace; letter-spacing: 1px; color: var(--accent); }
  .stack-hud p { font-size: 12px; color: var(--muted); }
  .demo-label { margin-left: auto; font: 9px monospace; color: var(--muted); border: 1px solid var(--line); padding: 4px 7px; }
  .visual-stack { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; align-items: stretch; }
  .stack-panel { --station-soft: light-dark(#e5e0d4, #33322a); min-width: 0; border: 1px solid var(--line); border-radius: 4px; background: var(--paper); box-shadow: 5px 5px 0 var(--line); display: flex; flex-direction: column; transition: border-color .2s; }
  .stack-panel:nth-child(2) { --station-soft: light-dark(#dbe4df, #25392f); }
  .stack-panel:nth-child(3) { --station-soft: light-dark(#dce3ed, #273442); }
  .stack-panel.is-active { border-color: var(--accent); }
  .station-title { padding: 12px; display: flex; justify-content: space-between; gap: 8px; border-bottom: 1px solid var(--line); font: 8px monospace; letter-spacing: .5px; color: var(--muted); }
  .station-title > span:last-child { color: var(--accent); white-space: nowrap; }
  .stack-panel-art { background: var(--surface); padding: 8px; border-bottom: 1px solid var(--line); }
  .station-body { padding: 20px 16px; display: flex; flex-direction: column; flex: 1; }
  .stack-panel h3 { font-size: 17px; font-weight: 600; margin-bottom: 14px; }
  .stack-panel ul { margin-bottom: 20px; }
  .stack-panel li { display: flex; align-items: center; gap: 9px; padding-block: 8px; border-bottom: 1px solid var(--line); font-size: 12px; }
  .tech-symbol { display: grid; place-items: center; width: 26px; height: 26px; flex-shrink: 0; border: 1px solid var(--line); font: 10px monospace; color: var(--muted); }
  .stack-panel li:hover .tech-symbol { color: var(--accent); border-color: var(--accent); }
  .station-terminal { margin-top: auto; padding: 12px 9px; background: var(--surface); border: 1px dashed var(--line); font: 9px/1.8 monospace; overflow-wrap: anywhere; }
  .station-terminal code { color: var(--accent); }.station-terminal p { margin-top: 7px; color: var(--muted); }
  .station-body button { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px; margin-top: 15px; min-height: 44px; border: 1px solid var(--line); background: transparent; cursor: pointer; font: 11px monospace; }
  .station-body button:hover, .station-body button[aria-pressed='true'] { color: var(--accent); border-color: var(--accent); }
  @media(min-width:861px) and (max-width:1100px) { .visual-stack { grid-template-columns: 1fr; } .stack-panel { display: grid; grid-template-columns: 190px minmax(0,1fr); } .station-title { grid-column: 1 / -1; } .stack-panel-art { align-self: start; border-bottom: 0; } }
  @media(max-width:700px) { .visual-stack { grid-template-columns: 1fr; gap: 26px; } .stack-panel-art { padding: 10px 25px; } .stack-panel-art :global(svg) { max-height: 170px; } .stack-panel li { font-size: 14px; } .station-body { padding: 22px; } }
  @media(prefers-reduced-motion:reduce) { .stack-panel { transition: none; } }
</style>
