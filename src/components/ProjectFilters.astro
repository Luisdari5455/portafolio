<div class="project-filters" role="group" aria-label="Filtrar proyectos" data-project-filters hidden>{['Todos', 'Frontend', 'Backend', 'Full Stack', 'Cloud', 'Mobile'].map((filter, i) => <button type="button" data-project-filter={i === 0 ? 'all' : filter} aria-pressed={i === 0}>{filter}</button>)}</div>
<script>
const filters = document.querySelector<HTMLElement>('[data-project-filters]');
if (filters) {
 filters.hidden = false;
 const buttons = [...filters.querySelectorAll<HTMLButtonElement>('button')];
 const projects = [...document.querySelectorAll<HTMLElement>('[data-project-categories]')];
 buttons.forEach(button => button.addEventListener('click', () => {
  const filter = button.dataset.projectFilter;
  buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
  projects.forEach(project => { project.hidden = filter !== 'all' && !(project.dataset.projectCategories ?? '').split('|').includes(filter ?? ''); });
  window.dispatchEvent(new Event('resize'));
 }));
}
</script>
<style>
.project-filters { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:28px; }
button { font:inherit; font-size:12px; background:var(--paper); color:var(--muted); border:1px solid var(--line); padding:10px 15px; min-height:44px; cursor:pointer; border-radius:3px; }
button[aria-pressed='true'] { color:var(--accent); border-color:var(--accent); background:var(--surface); }
</style>
