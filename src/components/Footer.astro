---
const currentYear = new Date().getFullYear();

const footerLinks = {
  company: [
    { name: 'Nosotros', href: '/nosotros' },
    { name: 'Servicios', href: '/servicios' },
    { name: 'Portafolio', href: '/portafolio' },
    { name: 'Blog', href: '/blog' },
  ],
  legal: [
    { name: 'Privacidad', href: '/privacidad' },
    { name: 'Términos', href: '/terminos' },
    { name: 'Cookies', href: '/cookies' },
  ],
  social: [
    { name: 'LinkedIn', href: '#', icon: 'linkedin' },
    { name: 'Twitter', href: '#', icon: 'twitter' },
    { name: 'GitHub', href: '#', icon: 'github' },
  ],
};
---

<footer class="footer">
  <div class="footer-content container">
    <div class="footer-section">
      <div class="footer-brand">
        <h3 class="footer-logo">INNOVATECH</h3>
        <p class="footer-tagline">GLOBAL SOLUTIONS</p>
        <p class="footer-description">
          Transformando ideas en soluciones tecnológicas innovadoras para empresas globales.
        </p>
      </div>
    </div>
    
    <div class="footer-section">
      <h4 class="footer-title">Empresa</h4>
      <ul class="footer-links">
        {footerLinks.company.map((link) => (
          <li>
            <a href={link.href} class="footer-link">{link.name}</a>
          </li>
        ))}
      </ul>
    </div>
    
    <div class="footer-section">
      <h4 class="footer-title">Legal</h4>
      <ul class="footer-links">
        {footerLinks.legal.map((link) => (
          <li>
            <a href={link.href} class="footer-link">{link.name}</a>
          </li>
        ))}
      </ul>
    </div>
    
    <div class="footer-section">
      <h4 class="footer-title">Contáctanos</h4>
      <p class="footer-contact">
        Email: <a href="mailto:info@innovatech.com" class="footer-link">info@innovatech.com</a>
      </p>
      <p class="footer-contact">
        Tel: +1 (555) 123-4567
      </p>
      <div class="social-links">
        {footerLinks.social.map((social) => (
          <a href={social.href} class="social-link" aria-label={social.name}>
            {social.name.charAt(0)}
          </a>
        ))}
      </div>
    </div>
  </div>
  
  <div class="footer-bottom container">
    <p class="copyright">
      © {currentYear} INNOVATECH GLOBAL SOLUTIONS. Todos los derechos reservados.
    </p>
  </div>
</footer>

<style>
  .footer {
    background: linear-gradient(135deg, var(--color-bg-dark) 0%, var(--color-bg-dark-alt) 100%);
    color: var(--color-text-dark);
    padding: var(--spacing-xl) 0 var(--spacing-md);
    margin-top: var(--spacing-xl);
  }
  
  .footer-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-lg);
  }
  
  .footer-brand {
    max-width: 300px;
  }
  
  .footer-logo {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-primary);
    margin-bottom: 0.25rem;
    text-shadow: 0 2px 8px rgba(255, 189, 89, 0.3);
  }
  
  .footer-tagline {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-primary-light);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: var(--spacing-sm);
  }
  
  .footer-description {
    color: #b0bec5;
    font-size: 0.95rem;
    line-height: 1.6;
  }
  
  .footer-title {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: var(--spacing-sm);
    color: white;
  }
  
  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .footer-links li {
    margin-bottom: 0.5rem;
  }
  
  .footer-link {
    color: #b0bec5;
    transition: color var(--transition-fast);
    font-size: 0.95rem;
  }
  
  .footer-link:hover {
    color: var(--color-secondary);
  }
  
  .footer-contact {
    color: #b0bec5;
    margin-bottom: 0.75rem;
    font-size: 0.95rem;
  }
  
  .social-links {
    display: flex;
    gap: 1rem;
    margin-top: var(--spacing-sm);
  }
  
  .social-link {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border-radius: 50%;
    font-weight: 700;
    transition: all var(--transition-base);
  }
  
  .social-link:hover {
    background: var(--color-primary);
    transform: translateY(-3px);
  }
  
  .footer-bottom {
    padding-top: var(--spacing-md);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
  }
  
  .copyright {
    color: #78909c;
    font-size: 0.875rem;
  }
  
  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }
  }
</style>
