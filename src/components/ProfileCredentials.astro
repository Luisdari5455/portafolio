---
import { Award, Languages, BadgeCheck } from '@lucide/astro';
import { timeline } from '../data/experience';
import { certifications, languages } from '../data/profile';
---
<div class="profile-credentials"><section class="credential-block education-block"><div class="credential-heading"><Award size={20} stroke-width={1.4} /><h3>Formación académica</h3></div>{timeline.filter(entry => entry.kind === 'Educación').map(entry => <div class="education-copy"><h4>{entry.title}</h4><p>{entry.subtitle}</p><p>{entry.period}</p></div>)}</section>
  <section class="credential-block" aria-labelledby="certifications-title">
    <div class="credential-heading"><Award size={20} stroke-width={1.4} /><h3 id="certifications-title">Certificaciones</h3></div>
    <div class="certificate-list">{certifications.map((certificate, index) => <article class="certificate-item"><div class="diploma" aria-hidden="true"><span class="diploma-number">0{index + 1}</span><i></i><i></i><i></i><span class="diploma-seal"><BadgeCheck size={25} stroke-width={1.2} /></span></div><h4>{certificate}</h4></article>)}</div>
  </section>
  <section class="credential-block" aria-labelledby="languages-title">
    <div class="credential-heading"><Languages size={20} stroke-width={1.4} /><h3 id="languages-title">Idiomas</h3></div>
    <ul class="language-list">{languages.map((language, index) => <li><span class="language-symbol" aria-hidden="true">{index === 0 ? 'Aa' : 'Hi'}<span>↗</span></span><div><h4>{language.name}</h4><p>{language.level}</p></div><span class="language-code" aria-hidden="true">{index === 0 ? 'ES' : 'EN'}</span></li>)}</ul>
  </section>
</div>
<style>
.education-block { grid-column:1 / -1; }.education-copy { padding-top:20px; }.education-copy h4 { font-weight:500; font-size:16px; }.education-copy p { color:var(--muted); font-size:13px; margin-top:8px; }
  .profile-credentials { margin-top: 36px; display: grid; gap: 30px; }
  .credential-heading { display: flex; align-items: center; gap: 10px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .credential-heading > svg { color: var(--accent); }
  .credential-heading h3 { font-size: 16px; font-weight: 600; }
  .certificate-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; padding-top: 20px; }
  .certificate-item { display: flex; gap: 16px; align-items: flex-start; }
  .certificate-item h4 { margin: 0; font-size: 14px; line-height: 1.6; font-weight: 450; color: var(--muted); }
  .diploma { flex-shrink: 0; width: 64px; height: 79px; position: relative; border: 1px solid var(--ink); border-radius: 2px; box-shadow: 3px 3px 0 var(--line); padding: 10px 8px; transform: rotate(-4deg); transition: transform .3s, box-shadow .3s; background: var(--paper); }
  .diploma-number { display: block; font: 7px monospace; color: var(--muted); margin-bottom: 7px; }
  .diploma i { display: block; height: 1px; margin-bottom: 5px; background: var(--line); }
  .diploma i:nth-last-of-type(1) { width: 65%; }
  .diploma-seal { position: absolute; bottom: -4px; right: 3px; color: var(--accent); background: var(--paper); }
  .certificate-item:hover .diploma { transform: rotate(0) translateY(-3px); box-shadow: 4px 6px 0 var(--line); }
  .language-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; padding-top: 20px; }
  .language-list li { display: flex; gap: 14px; align-items: center; min-width: 0; }
  .language-symbol { display: grid; place-items: center; width: 48px; height: 45px; flex-shrink: 0; border: 1px solid var(--ink); border-radius: 6px 6px 6px 0; font-size: 20px; position: relative; box-shadow: 3px 3px 0 var(--line); }
  .language-symbol > span { position: absolute; top: -9px; right: -6px; font-size: 13px; color: var(--accent); background: var(--paper); padding-inline: 3px; }
  .language-list h4 { font-size: 15px; font-weight: 550; margin: 0; }
  .language-list p { font-size: 12px; color: var(--muted); margin: 2px 0 0; }
  .language-code { margin-left: auto; font: 10px monospace; color: var(--muted); }
  @media(max-width: 580px) { .certificate-list, .language-list { grid-template-columns: 1fr; } }
  @media(prefers-reduced-motion:reduce) { .diploma { transition: none; } .certificate-item:hover .diploma { transform: none; } }
</style>
