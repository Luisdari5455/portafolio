---
import PixelMark from './PixelMark.astro';
---
<div class="pixel-signature" data-pixel-signature>
  <div class="pixel-monitor" aria-hidden="true">
    <div class="pixel-screen"><span data-pixel-frame="0"><PixelMark /></span><span data-pixel-frame="1" hidden><PixelMark variant="coffee" /></span><span data-pixel-frame="2" hidden><PixelMark variant="spark" /></span></div>
    <span class="monitor-light"></span><span class="monitor-base"></span>
  </div>
  <div class="pixel-signature-copy"><span class="pixel-signer">LUIS COTOC <span aria-hidden="true">/</span> PIXEL EDITION</span><p class="pixel-message" aria-live="polite" aria-atomic="true"><span data-pixel-caption="0">Código con firma propia.</span><span data-pixel-caption="1" hidden>Una idea. Un café. A crear.</span><span data-pixel-caption="2" hidden>Los detalles hacen la diferencia.</span></p></div>
  <button type="button" class="pixel-switch" data-pixel-switch aria-label="Cambiar ilustración pixelada" title="Cambiar ilustración pixelada" hidden><span aria-hidden="true">↻</span></button>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-pixel-signature]').forEach(signature => {
    const button = signature.querySelector<HTMLButtonElement>('[data-pixel-switch]');
    if (!button) return;
    button.hidden = false;
    let frame = 0;
    button.addEventListener('click', () => {
      frame = (frame + 1) % 3;
      signature.querySelectorAll<HTMLElement>('[data-pixel-frame]').forEach(element => { element.hidden = Number(element.dataset.pixelFrame) !== frame; });
      signature.querySelectorAll<HTMLElement>('[data-pixel-caption]').forEach(element => { element.hidden = Number(element.dataset.pixelCaption) !== frame; });
    });
  });
</script>
<style>
  .pixel-signature { display: flex; align-items: center; gap: 16px; width: fit-content; max-width: 100%; margin-block: 24px; padding: 12px 14px 16px; border: 1px dashed var(--line); border-radius: 4px; background: var(--paper); }
  .pixel-monitor { width: 57px; height: 57px; position: relative; flex-shrink: 0; }
  .pixel-screen { position: relative; border: 1px solid var(--ink); border-radius: 2px; padding: 4px; background: var(--surface); box-shadow: 3px 3px 0 var(--line); }
  .pixel-screen > span { display: block; }
  .pixel-screen :global(svg) { display: block; width: 46px; height: 36px; color: var(--accent); }
  .monitor-base { position: absolute; bottom: 0; left: 15px; width: 28px; height: 5px; border-bottom: 2px solid var(--ink); }
  .monitor-base::before { content: ''; position: absolute; left: 12px; width: 5px; height: 8px; top: -5px; background: var(--ink); }
  .monitor-light { position: absolute; width: 3px; height: 3px; bottom: 12px; right: 5px; background: var(--accent); }
  .pixel-signature-copy { min-width: 0; }
  .pixel-signer { font: 8px/1.6 monospace; letter-spacing: 1px; color: var(--muted); }
  .pixel-signer > span { color: var(--accent); margin-inline: 3px; }
  .pixel-message { font-size: 12px; line-height: 1.5; margin-top: 5px; }
  .pixel-switch { border: 1px solid var(--line); border-radius: 2px; background: var(--surface); display: grid; place-items: center; min-width: 44px; min-height: 44px; margin-left: 4px; cursor: pointer; transition: box-shadow .2s, color .2s; }
  .pixel-switch > span { font: 24px monospace; }
  .pixel-switch:hover { color: var(--accent); box-shadow: 3px 3px 0 var(--line); }
  @media(max-width: 580px) { .pixel-signature { gap: 10px; padding-inline: 10px; } .pixel-signer { font-size: 7px; letter-spacing: .5px; } .pixel-message { font-size: 11px; } .pixel-switch { margin-left: 0; } }
  @media(prefers-reduced-motion:reduce) { .pixel-switch { transition: none; } }
</style>
