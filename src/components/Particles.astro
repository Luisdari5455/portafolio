---
// Componente de partículas decorativas animadas
---

<div class="particles-container">
  <div class="particle particle-1"></div>
  <div class="particle particle-2"></div>
  <div class="particle particle-3"></div>
  <div class="particle particle-4"></div>
  <div class="particle particle-5"></div>
  <div class="particle particle-6"></div>
</div>

<style>
  .particles-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  
  .particle {
    position: absolute;
    border-radius: 50%;
    opacity: 0.15;
    animation: floatParticle 15s infinite ease-in-out;
  }
  
  .particle-1 {
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, #ffbd59, #ff6b35);
    top: 10%;
    left: 10%;
    animation-delay: 0s;
  }
  
  .particle-2 {
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, #ff6b35, #ffbd59);
    top: 70%;
    left: 80%;
    animation-delay: 2s;
  }
  
  .particle-3 {
    width: 100px;
    height: 100px;
    background: linear-gradient(135deg, #ffbd59, #ffd280);
    top: 40%;
    left: 5%;
    animation-delay: 4s;
  }
  
  .particle-4 {
    width: 50px;
    height: 50px;
    background: linear-gradient(135deg, #ff6b35, #e55a2b);
    top: 20%;
    left: 85%;
    animation-delay: 1s;
  }
  
  .particle-5 {
    width: 70px;
    height: 70px;
    background: linear-gradient(135deg, #ffd280, #ffbd59);
    top: 80%;
    left: 20%;
    animation-delay: 3s;
  }
  
  .particle-6 {
    width: 90px;
    height: 90px;
    background: linear-gradient(135deg, #ffbd59, #ff8c61);
    top: 50%;
    left: 90%;
    animation-delay: 5s;
  }
  
  @keyframes floatParticle {
    0%, 100% {
      transform: translate(0, 0) rotate(0deg);
    }
    25% {
      transform: translate(30px, -30px) rotate(90deg);
    }
    50% {
      transform: translate(-20px, 20px) rotate(180deg);
    }
    75% {
      transform: translate(20px, 30px) rotate(270deg);
    }
  }
  
  @media (max-width: 768px) {
    .particle {
      opacity: 0.08;
    }
  }
</style>
