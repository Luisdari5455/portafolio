<div class="pixel-scroll-progress" data-pixel-scroll aria-hidden="true"><span></span></div>
<script>
  const rail = document.querySelector<HTMLElement>('[data-pixel-scroll]');
  if (rail) {
    const fill = rail.querySelector<HTMLElement>('span')!;
    let frame = 0;
    const update = () => {
      frame = 0;
      const range = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      rail.hidden = range <= 0;
      fill.style.width = `${range > 0 ? Math.min(100, Math.max(0, window.scrollY / range * 100)) : 0}%`;
    };
    const request = () => { if (!frame) frame = requestAnimationFrame(update); };
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', request);
    new ResizeObserver(request).observe(document.body);
    update();
  }
</script>
<style>
.pixel-scroll-progress { position:fixed; top:0; left:0; right:0; height:4px; z-index:60; pointer-events:none; background:transparent; }
.pixel-scroll-progress span { display:block; width:0; height:100%; background:repeating-linear-gradient(90deg,var(--accent) 0 8px,transparent 8px 11px); }
@media(forced-colors:active) { .pixel-scroll-progress span { background:Highlight; } }
</style>
