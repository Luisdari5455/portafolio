---
import '@fontsource-variable/schibsted-grotesk';
import { ArrowDown, ArrowUp, ArrowUpRight, Download, Github, Linkedin, Mail } from '@lucide/astro';
import JourneyTimeline from './JourneyTimeline.astro';
import { profile } from '../data/profile';
import ContactEnvelope from './ContactEnvelope.astro';
import WelcomeSetup from './WelcomeSetup.astro';


import ProjectPixelBackdrop from './ProjectPixelBackdrop.astro';
import RetroComputer from './RetroComputer.astro';
import CodeThought from './CodeThought.astro';
import SoundControl from './SoundControl.astro';
import SystemBackground from './SystemBackground.astro';
import PixelScroll from './PixelScroll.astro';
import ProjectFilters from './ProjectFilters.astro';
import ProjectCase from './ProjectCase.astro';
import ProfessionalServices from './ProfessionalServices.astro';
import ContactForm from './ContactForm.astro';
import PixelSignature from './PixelSignature.astro';
import BootSplash from './BootSplash.astro';
import PixelPointer from './PixelPointer.astro';
import DeveloperStudio from './DeveloperStudio.astro';
import ProcessStudio from './ProcessStudio.astro';
import XelaBackdrop from './XelaBackdrop.astro';
import ProfileCredentials from './ProfileCredentials.astro';
import VisualStack from './VisualStack.astro';
import InnovationFocus from './InnovationFocus.astro';
import ArchitectureLab from './ArchitectureLab.astro';
import { projects } from '../data/projects';
import PortfolioNav from './PortfolioNav.astro';
import ProjectIcon from './ProjectIcon.astro';
import ProjectSketch from './ProjectSketch.astro';
import '../styles/portfolio.css';
interface Props { projectsOnly?: boolean; }
const { projectsOnly = false } = Astro.props;

const hasContact = Boolean(profile.email || profile.github || profile.linkedin);
const siteName = profile.name || 'Portafolio';
const heroMeta = [profile.role, profile.location].filter(Boolean).join(' · ');
const steps = [
  { title: 'Entender', description: 'Definir el problema, quién va a usar el producto y qué necesita resolver antes de escribir código.' },
  { title: 'Dar forma', description: 'Organizar la información, decidir la dirección visual y pensar cómo se recorre cada pantalla.' },
  { title: 'Construir', description: 'Convertir el diseño en componentes, conectar las interacciones y cuidar que funcione en cualquier pantalla.' },
  { title: 'Revisar', description: 'Probar los recorridos, la navegación con teclado y el comportamiento de cada elemento, y ajustar.' },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fbfaf8" />
    <meta name="description" content={`${siteName}, ${profile.role}. Sistemas empresariales, integraciones eCommerce y aplicaciones escalables con React.js, Node.js, .NET y Azure.`} />
    <title>{projectsOnly ? `Proyectos · ${siteName}` : `${siteName} · ${profile.role}`}</title>
    <link rel="icon" href="/portfolio-mark.svg" type="image/svg+xml" />
    <!-- Resolve the theme before first paint to avoid a flash. -->
    <script is:inline>
      (function () {
        var root = document.documentElement, theme = null;
        root.classList.add('js');
        try { theme = localStorage.getItem('portfolio-theme'); } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        root.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class="portfolio"><PixelScroll /><SystemBackground /><BootSplash /><WelcomeSetup /><PixelPointer />
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <PortfolioNav hasContact={hasContact} />
    <main id="contenido" tabindex="-1" class="wrap">
      {!projectsOnly && (
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
          <p class="hero-meta">{heroMeta}{profile.available && <span class="availability"><i aria-hidden="true"></i>Disponible para nuevos proyectos</span>}</p>
          <h1 id="hero-title">{profile.name}<span class="name-code-caret" aria-hidden="true">_</span></h1>
          <p class="hero-lead">Desarrollo sistemas empresariales, integraciones eCommerce y aplicaciones escalables.</p>
          <p class="hero-intro">Experiencia en proyectos para Walmart CAM y Cemaco.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#proyectos">Ver proyectos <ArrowDown size={18} /></a>
            {profile.email && <a class="button" href={`mailto:${profile.email}`}><Mail size={18} />Escribirme</a>}
            {profile.cv && <a class="button" href={profile.cv} download><Download size={18} />Descargar CV</a>}
          </div><div class="profile-resources">{profile.github && <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>}{profile.linkedin && <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>}{!profile.cv && <span>CV en PDF: pendiente de adjuntar</span>}</div>
          </div>
          <div class="hero-showcase"><RetroComputer /></div>
          <div class="hero-bottom"><span class="hero-bottom-note">Código con propósito. Diseño con personalidad.</span><div class="hero-utilities"><SoundControl /><a class="hero-inspiration-link" href="#mi-inspiracion"><span aria-hidden="true">&lt;/&gt;</span> Una dosis de inspiración <span aria-hidden="true">↗</span></a><button class="hero-customize" type="button" data-open-welcome hidden>Personalizar mi visita</button></div></div>
        </section>
      )}

      <section id="proyectos" class="section" aria-labelledby="projects-title">
        <header class="section-head">
          {projectsOnly ? <h1 class="section-title" id="projects-title">Proyectos</h1> : <h2 class="section-title" id="projects-title">Proyectos</h2>}
          <p>{projects.length} trabajos entre sitios web y sistemas.</p>
        </header>
        <div class="section-body project-list"><ProjectFilters />
          {projects.map((project, index) => (
            <article class="project" data-project-categories={(project.filters ?? []).join("|")} aria-labelledby={`title-${project.id}`} data-tilt>
              <div class="project-thumb" data-parallax="-0.06" aria-hidden={project.image ? undefined : 'true'}>
                <ProjectPixelBackdrop index={index} /><div class="thumb-card" data-scroll-pos>
                  {project.image
                    ? <img src={project.image} alt={`Captura de ${project.title}`} loading="lazy" />
                    : <ProjectSketch index={index} />}
                  <span class="thumb-icon" aria-hidden="true"><ProjectIcon id={project.id} /></span>
                </div>
              </div>
              <div class="project-main">
                <div class="project-heading">
                  <h3 id={`title-${project.id}`}>{project.title}</h3>
                  <p class="project-meta">{[String(index + 1).padStart(2, '0'), project.category, project.year, project.status].filter(Boolean).join(' · ')}</p>
                </div>
                {!project.image && <p class="concept-label">Representación conceptual</p>}<p class="project-description">{project.description}</p>

                {project.role && <p class="project-detail"><strong>Mi rol:</strong> {project.role}</p>}
                {project.stack && <ul class="tag-list" aria-label="Tecnologías">{project.stack.map(item => <li>{item}</li>)}</ul>}
                {(project.url || project.repo) && (
                  <p class="project-links">
                    {project.url && <a class="text-link" href={project.url} target="_blank" rel="noopener">Ver sitio <ArrowUpRight size={16} /></a>}
                    {project.repo && <a class="text-link" href={project.repo} target="_blank" rel="noopener"><Github size={16} /> Código</a>}
                  </p>
                )}
                <ProjectCase project={project} />
              </div>
            </article>
          ))}
        </div>
      </section>

      <JourneyTimeline />

      <section id="stack" class="section" aria-labelledby="stack-title">
        <header class="section-head"><h2 class="section-title" id="stack-title">Stack</h2><p>Tecnologías con las que trabajo.</p></header>
        <div class="section-body"><VisualStack /><InnovationFocus /></div>
      </section>

      <ArchitectureLab /><section id="sobre-mi" class="section section-wide" aria-labelledby="about-title">
        <header class="section-head"><h2 class="section-title" id="about-title">Sobre mí</h2></header>
        <div class={`section-body about ${profile.photo ? 'has-photo' : ''}`}>
          {profile.photo && <img class="about-photo" src={profile.photo} alt={profile.name ? `Foto de ${profile.name}` : 'Foto de perfil'} loading="lazy" />}
          <div class="about-layout"><div class="about-visual"><DeveloperStudio /></div><div class="prose">
            <p>Soy Full Stack Developer con experiencia en desarrollo de sistemas empresariales, integraciones eCommerce y arquitectura de aplicaciones escalables.</p>
            <p>Desde la planificación hasta producción, conecto Frontend, Backend y APIs REST para crear aplicaciones escalables y mantenibles.</p><p>Trabajo con arquitecturas cloud y microfrontends, resolución de problemas, revisiones de código y acompañamiento técnico a equipos.</p>
            <p>Me adapto continuamente a nuevas tecnologías y estoy incorporando el aprendizaje de inteligencia artificial a mi evolución profesional, con foco en soluciones útiles y criterio técnico.</p>
          </div><div class="about-credentials"><ProfileCredentials /></div><div class="about-personality" id="mi-inspiracion"><div class="about-personality-copy"><h3>Código con firma propia.</h3><PixelSignature /><p>He trabajado en proyectos para Walmart CAM y Cemaco con React.js, Node.js, .NET, Azure Functions, SQL Server y microfrontends.</p></div><CodeThought /></div></div>
        </div>
      </section>

      <ProfessionalServices /><section id="proceso" class="section" aria-labelledby="process-title">
        <header class="section-head"><h2 class="section-title" id="process-title">Proceso</h2><p>Cómo abordo un proyecto, de principio a fin.</p></header>
        <ProcessStudio steps={steps} />
      </section>

      {hasContact && (
        <section id="contacto" class="section contact-landscape" aria-labelledby="contact-title">
          <XelaBackdrop /><header class="section-head"><h2 class="section-title" id="contact-title">Contacto</h2></header>
          <div class="section-body contact">
            <div>
            <p class="contact-lead">¿Tienes un proyecto en mente? Escríbeme y lo conversamos.</p>
            <ul class="contact-list">
              {profile.email && <li><a href={`mailto:${profile.email}`}><Mail size={18} />{profile.email}</a></li>}
              {profile.github && <li><a href={profile.github} target="_blank" rel="noopener me"><Github size={18} />GitHub</a></li>}
              {profile.linkedin && <li><a href={profile.linkedin} target="_blank" rel="noopener me"><Linkedin size={18} />LinkedIn</a></li>}
            </ul><p class="profile-pending">Guatemala</p>{profile.cv ? <a class="text-link" href={profile.cv} download>Descargar CV</a> : <p class="profile-pending">CV en PDF: pendiente de adjuntar</p>}{profile.available && <p class="profile-pending">Disponible para empleo y proyectos freelance.</p>}
            </div>
            {profile.email && <ContactEnvelope email={profile.email} name={profile.shortName} />}<ContactForm />
          </div>
        </section>
      )}
    </main>
    <footer class="site-footer wrap">
      <span>© {new Date().getFullYear()} {siteName}</span>
      <a href="#contenido">Volver arriba <ArrowUp size={16} /></a>
    </footer>
    <script>
      import '../scripts/visitor-preferences';
      import '../scripts/portfolio';
    </script>
  </body>
</html>








