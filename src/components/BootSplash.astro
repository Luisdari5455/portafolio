---
import PixelMark from './PixelMark.astro';
---
<dialog class="boot-splash" data-boot-splash aria-label="Inicio del portafolio / Portfolio introduction">
  <div class="boot-card"><span class="boot-label">LUIS COTOC / PORTFOLIO</span><div class="boot-mark"><PixelMark /></div><p class="boot-title">Hola / Hello<span aria-hidden="true">_</span></p><p class="boot-subtitle">Preparando tu espacio / Preparing your space</p><div class="boot-track" role="progressbar" aria-label="Preparando portafolio"><span></span></div><div class="boot-bottom"><span>CODE · FAITH · PURPOSE</span><button type="button" data-boot-skip>Continuar / Continue ↗</button></div></div>
</dialog>
<script is:inline>
  (function () {
    var splash = document.querySelector('[data-boot-splash]');
    if (!splash) return;
    splash.showModal();
    splash.addEventListener('cancel', function (event) { event.preventDefault(); finish(); });
    var finished = false;
    var timeout;
    function finish() {
      if (finished) return;
      finished = true;
      clearTimeout(timeout);
      splash.close(); splash.hidden = true;
      document.documentElement.classList.add('boot-done');
      document.dispatchEvent(new CustomEvent('portfolio:booted'));
    }
    splash.querySelector('[data-boot-skip]').addEventListener('click', finish);
    // Upper bound guarantees the page remains available even if fonts or scripts fail.
    timeout = setTimeout(finish, 2400);
    var ready = document.readyState === 'loading' ? new Promise(function (resolve) { document.addEventListener('DOMContentLoaded', resolve, { once: true }); }) : Promise.resolve();
    Promise.all([ready, document.fonts.ready, new Promise(function (resolve) { setTimeout(resolve, matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 1000); })]).then(finish).catch(finish);
  })();
</script>
<style>
  .boot-splash { display: none; position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; border: 0; z-index: 1000; background: var(--paper); color: var(--ink); place-items: center; padding: 24px; overflow-y: auto; }
  .boot-splash[open] { display: grid; }
  .boot-card { width: min(500px, 100%); }
  .boot-label { font: 11px monospace; letter-spacing: 2px; color: var(--muted); }
  .boot-mark { width: 100px; margin: 40px 0 28px; color: var(--accent); }
  .boot-mark :global(svg) { width: 100%; display: block; filter: drop-shadow(5px 5px 0 var(--line)); }
  .boot-title { font: 36px monospace; letter-spacing: -2px; }.boot-title > span { color: var(--accent); }
  .boot-subtitle { font: 11px/1.8 monospace; color: var(--muted); margin-top: 12px; }
  .boot-track { height: 24px; padding: 4px; margin-top: 30px; border: 1px solid var(--ink); box-shadow: 4px 4px 0 var(--line); overflow: hidden; }
  .boot-track > span { display: block; height: 100%; width: 100%; background: repeating-linear-gradient(90deg, var(--accent) 0 14px, transparent 14px 18px); transform-origin: left; animation: boot-progress 1.1s steps(16) both; }
  .boot-bottom { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-top: 25px; font: 9px monospace; color: var(--muted); }
  .boot-bottom button { background: transparent; border: 0; padding: 12px 0; min-height: 44px; font: inherit; cursor: pointer; }
  .boot-bottom button:hover { color: var(--accent); }
  @keyframes boot-progress { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  @media(prefers-reduced-motion:reduce) { .boot-track > span { animation: none; } }
</style>

