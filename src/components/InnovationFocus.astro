---
import { innovation } from '../data/innovation';
import { Workflow, Layers, Radio, Cpu, Check } from '@lucide/astro';
const icons = [Workflow, Layers, Radio];
---
<div class="innovation-focus">
 <header><h3>{innovation.title}</h3><p>{innovation.intro}</p></header>
 <div class="capability-grid">{innovation.areas.map((area, index) => {const Icon = icons[index]; return <article><Icon size={23} stroke-width={1.4} aria-hidden="true"/><h4>{area.title}</h4><p>{area.text}</p><a href={area.href} data-innovation-project>{area.proof}<span aria-hidden="true">↗</span></a></article>;})}</div>
 <article class="ai-direction"><div class="ai-emblem" aria-hidden="true"><Cpu size={42} stroke-width={1}/><span>&lt; / &gt;</span></div><div><div class="ai-heading"><h3>{innovation.aiTitle}</h3><span class="learning-label">{innovation.aiStatus}</span></div><p>{innovation.aiDescription}</p><ul>{innovation.principles.map(principle => <li><Check size={14} stroke-width={1.5} aria-hidden="true"/><span>{principle}</span></li>)}</ul></div></article>
</div>
<script>
document.querySelectorAll<HTMLAnchorElement>('[data-innovation-project]').forEach(link => link.addEventListener('click', () => {
 // A project link must also work after a visitor has applied a different filter.
 document.querySelector<HTMLButtonElement>('[data-project-filter="all"]')?.click();
}));
</script>
<style>
.innovation-focus { margin-top:48px; padding-top:32px; border-top:1px solid var(--line); }
h3 { font-size:clamp(21px,2vw,27px); font-weight:500; line-height:1.35; letter-spacing:-.025em; }
header > p { font-size:14px; line-height:1.8; color:var(--muted); max-width:70ch; margin-top:12px; }
.capability-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:20px; margin-top:28px; }
.capability-grid article { border:1px solid var(--line); border-radius:4px; padding:24px; background:var(--paper); display:flex; flex-direction:column; }
.capability-grid article > svg { color:var(--accent); }h4 { font-size:17px; font-weight:500; margin:16px 0 12px; }
.capability-grid p,.ai-direction p { font-size:14px; line-height:1.8; color:var(--muted); }
.capability-grid a { display:flex; align-items:center; justify-content:space-between; gap:10px; font-size:11px; min-height:44px; padding-top:18px; margin-top:auto; color:var(--accent); }
.ai-direction { margin-top:24px; display:grid; grid-template-columns:90px minmax(0,1fr); gap:28px; padding:clamp(24px,3vw,36px); background:var(--surface); border:1px solid var(--line); border-radius:4px; }
.ai-emblem { display:grid; align-content:center; justify-items:center; gap:14px; color:var(--accent); border:1px dashed var(--line); height:110px; font:12px monospace; }.ai-heading { display:flex; flex-wrap:wrap; align-items:center; gap:12px 20px; margin-bottom:14px; }.ai-heading h3 { font-size:21px; }.learning-label { font:10px monospace; color:var(--accent); border:1px solid var(--line); padding:6px 9px; }
ul { display:flex; flex-wrap:wrap; gap:12px 24px; margin-top:20px; }li { display:flex; gap:8px; align-items:baseline; font-size:12px; color:var(--muted); }li svg { flex-shrink:0; color:var(--accent); }
@media(max-width:1100px) { .capability-grid { grid-template-columns:1fr; } }
@media(max-width:580px) { .ai-direction { grid-template-columns:1fr; gap:20px; }.ai-emblem { width:70px; height:70px; }.ai-emblem span { display:none; } }
</style>
