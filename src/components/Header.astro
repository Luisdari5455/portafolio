---
import { Globe, Moon, Sun } from '@lucide/astro';
import { getTranslations } from '../i18n/translations';

const currentPath = Astro.url.pathname;
const currentLang = currentPath.startsWith('/en') ? 'en' : 'es';
const t = getTranslations(currentLang);

const navItems = [
  { name: t.nav.home, href: currentLang === 'en' ? '/en' : '/' },
  { name: t.nav.services, href: currentLang === 'en' ? '/en/servicios' : '/servicios' },
  { name: t.nav.portfolio, href: currentLang === 'en' ? '/en/portafolio' : '/portafolio' },
  { name: t.nav.about, href: currentLang === 'en' ? '/en/nosotros' : '/nosotros' },
  { name: t.nav.contact, href: currentLang === 'en' ? '/en/contacto' : '/contacto' },
];
---

<header class="header">
  <nav class="nav container">
    <a href="/" class="logo">
      <span class="logo-text">INNOVATECH</span>
      <span class="logo-subtitle">GLOBAL SOLUTIONS</span>
    </a>
    
    <div class="nav-actions">
      <ul class="nav-menu" id="navMenu">
        {navItems.map((item) => (
          <li class="nav-item">
            <a 
              href={item.href} 
              class={`nav-link ${currentPath === item.href ? 'active' : ''}`}
            >
              {item.name}
            </a>
          </li>
        ))}
      </ul>
      
      <button class="theme-toggle" aria-label="Cambiar tema" id="themeToggle" title="Cambiar tema">
        <Sun class="sun-icon" size={20} />
        <Moon class="moon-icon" size={20} />
      </button>

      <button class="lang-toggle" aria-label="Cambiar idioma" id="langToggle" title="Cambiar idioma">
        <span class="lang-text" id="langText">{currentLang === 'es' ? 'ES' : 'EN'}</span>
        <Globe size={16} />
      </button>
      
      <button class="menu-toggle" aria-label="Toggle menu" id="menuToggle">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(10px);
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.08);
    z-index: 1000;
    transition: all var(--transition-base);
    border-bottom: 1px solid rgba(255, 189, 89, 0.1);
  }

  :global(body.dark-mode) .header {
    background: rgba(15, 23, 42, 0.98);
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.3);
    border-bottom: 1px solid rgba(255, 189, 89, 0.2);
  }
  
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 2rem;
    max-width: 1400px;
  }
  
  .logo {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    gap: 0;
    transition: transform var(--transition-base);
  }
  
  .logo:hover {
    transform: scale(1.05);
  }
  
  .logo-text {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-bg-dark);
    line-height: 1;
    text-shadow: 0 2px 4px rgba(255, 189, 89, 0.2);
  }

  :global(body.dark-mode) .logo-text {
    color: white;
    text-shadow: 0 0 20px rgba(255, 189, 89, 0.5);
  }
  
  .logo-subtitle {
    font-size: 0.625rem;
    font-weight: 600;
    color: var(--color-primary);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-top: 0.125rem;
  }

  :global(body.dark-mode) .logo-subtitle {
    color: var(--color-primary);
  }
  
  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }
  
  .menu-toggle span {
    display: block;
    width: 25px;
    height: 3px;
    background: var(--color-primary);
    border-radius: 3px;
    transition: all var(--transition-base);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 189, 89, 0.1);
    border: 2px solid rgba(255, 189, 89, 0.3);
    cursor: pointer;
    transition: all 0.3s ease;
    color: var(--color-primary-dark);
  }

  .theme-toggle:hover {
    background: var(--color-primary);
    color: white;
    transform: rotate(15deg) scale(1.1);
    box-shadow: 0 5px 20px rgba(255, 189, 89, 0.4);
  }

  .sun-icon {
    display: none;
  }

  .moon-icon {
    display: block;
  }

  :global(body.dark-mode) .sun-icon {
    display: block;
  }

  :global(body.dark-mode) .moon-icon {
    display: none;
  }

  :global(body.dark-mode) .theme-toggle {
    background: rgba(255, 189, 89, 0.15);
    color: var(--color-primary);
  }

  .lang-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    height: 40px;
    padding: 0 1rem;
    border-radius: 20px;
    background: rgba(255, 189, 89, 0.1);
    border: 2px solid rgba(255, 189, 89, 0.3);
    cursor: pointer;
    transition: all 0.3s ease;
    color: var(--color-primary-dark);
    font-weight: 600;
    font-size: 0.875rem;
  }

  .lang-toggle:hover {
    background: var(--color-primary);
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 5px 20px rgba(255, 189, 89, 0.4);
  }

  .lang-text {
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  :global(body.dark-mode) .lang-toggle {
    background: rgba(255, 189, 89, 0.15);
    color: var(--color-primary);
  }
  
  .nav-menu {
    display: flex;
    list-style: none;
    gap: 2rem;
    margin: 0;
    padding: 0;
  }
  
  .nav-link {
    position: relative;
    font-weight: 600;
    color: var(--color-bg-dark);
    transition: color var(--transition-fast);
    padding: 0.5rem 0;
    text-decoration: none;
  }

  :global(body.dark-mode) .nav-link {
    color: rgba(255, 255, 255, 0.9);
  }
  
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    transition: width var(--transition-base);
  }
  
  .nav-link:hover,
  .nav-link.active {
    color: var(--color-primary);
  }
  
  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }
  
  @media (max-width: 768px) {
    .menu-toggle {
      display: flex;
    }
    
    .nav-menu {
      position: fixed;
      top: 70px;
      right: -100%;
      flex-direction: column;
      background: white;
      width: 80%;
      max-width: 300px;
      padding: 2rem;
      box-shadow: var(--shadow-lg);
      transition: right var(--transition-base);
      border-radius: var(--border-radius-lg) 0 0 var(--border-radius-lg);
    }

    :global(body.dark-mode) .nav-menu {
      background: var(--color-bg-dark-alt);
    }
    
    .nav-menu.active {
      right: 0;
    }

    .nav-actions {
      gap: 1rem;
    }
  }
</style>

<script>
  const menuToggle = document.getElementById('menuToggle');
  const navMenu = document.getElementById('navMenu');
  const themeToggle = document.getElementById('themeToggle');
  const langToggle = document.getElementById('langToggle');
  
  // Menu toggle
  menuToggle?.addEventListener('click', () => {
    navMenu?.classList.toggle('active');
  });
  
  // Cerrar menú al hacer click en un enlace
  const navLinks = document.querySelectorAll('.nav-link');
  navLinks.forEach(link => {
    link.addEventListener('click', () => {
      navMenu?.classList.remove('active');
    });
  });

  // Theme toggle
  function initTheme() {
    const savedTheme = localStorage.getItem('theme');
    if (savedTheme === 'dark') {
      document.body.classList.add('dark-mode');
    } else if (savedTheme === 'light') {
      document.body.classList.remove('dark-mode');
    }
  }

  function toggleTheme() {
    document.body.classList.toggle('dark-mode');
    const isDark = document.body.classList.contains('dark-mode');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  }

  // Initialize theme on page load
  initTheme();

  // Theme toggle button
  themeToggle?.addEventListener('click', toggleTheme);

  // Language toggle
  langToggle?.addEventListener('click', () => {
    const currentPath = window.location.pathname;
    let newPath = '';

    if (currentPath.startsWith('/en')) {
      // Switch to Spanish - remove /en prefix
      newPath = currentPath.replace(/^\/en/, '') || '/';
    } else {
      // Switch to English - add /en prefix
      newPath = '/en' + currentPath;
    }

    window.location.href = newPath;
  });
</script>
